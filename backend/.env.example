# TRACE AI - Environment Configuration Example
# Copy this file to .env and adjust variables as needed

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True
ENVIRONMENT=development

# Application Info
PROJECT_NAME="TRACE AI Backend"
API_PREFIX=/api

# CORS Configuration (Comma-separated list of allowed origins)
# Default allows the React dev server
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration (SQLite)
DATABASE_URL=sqlite:///./trace_ai.db

# Storage Directory for Uploaded Evidence (stored outside database)
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE_MB=100

# Featherless AI Service Configuration
# Keep FEATHERLESS_API_KEY exclusively on backend; do not expose to frontend or git
FEATHERLESS_API_KEY=your_featherless_api_key_here
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
FEATHERLESS_TIMEOUT_SECONDS=60.0
# Set FEATHERLESS_MOCK_MODE=True to run deterministic local mock analysis without external API calls
FEATHERLESS_MOCK_MODE=False
